# ===== CẤU HÌNH SERVER =====
GEMINI_API_KEY=               # Lấy miễn phí tại: https://aistudio.google.com/apikey
SUPABASE_URL=                 # Project Settings > API > Project URL
SUPABASE_SERVICE_ROLE_KEY=    # Project Settings > API > service_role (secret - TUYỆT ĐỐI không để lộ ra frontend)
DAILY_AI_QUOTA=80             # Hạn mức số lượt gọi AI mỗi ngày cho mỗi người dùng

# ===== CẤU HÌNH FRONTEND (Client) =====
VITE_SUPABASE_URL=            # Giống SUPABASE_URL
VITE_SUPABASE_ANON_KEY=       # Project Settings > API > anon public
